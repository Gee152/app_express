{
  "name": "catalogo-express-backend",
  "version": "1.0.0",
  "description": "Backend desacoplado com Clean Architecture e SOLID para o Catálogo Express",
  "main": "dist/delivery/http/server.js",
  "scripts": {
    "dev": "tsx watch src/delivery/http/server.ts",
    "build": "tsc",
    "start": "node dist/delivery/http/server.js",
    "test": "jest --config jest.config.cjs",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/infrastructure/database/typeorm/data-source.ts",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/infrastructure/database/typeorm/data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/infrastructure/database/typeorm/data-source.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.1",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
