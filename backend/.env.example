# Server
PORT=3333
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=catalogo_express

# JWT Authentication
JWT_SECRET=supersecretjwtkey_change_in_production_cat_express_2026
JWT_EXPIRES_IN=1d

# WhatsApp Gateway (Evolution API / Z-API / Mock)
# Se EVOLUTION_API_KEY estiver vazia, o sistema usa automaticamente o MockWhatsAppProvider para testes locais sem falhar
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_global_ou_da_instancia_aqui
EVOLUTION_INSTANCE_NAME=catalogo_express

